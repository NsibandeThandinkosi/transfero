
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Transfero</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Transfero.Web.styles.css"
          asp-append-version="true" />
</head>

<body>
    <!-- Main Navigation -->
    <header class="transfero-header">
        <nav class="transfero-navbar" aria-label="Main navigation">

            <a class="transfero-brand"
               asp-controller="Home"
               asp-action="Index"
               aria-label="Transfero home">
                <span class="brand-icon">T</span>
                <span>transfero<span class="brand-dot">.</span></span>
            </a>

            <button class="mobile-menu-toggle"
                    type="button"
                    aria-label="Toggle navigation"
                    aria-expanded="false"
                    aria-controls="main-navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="navbar-content" id="main-navigation">
                <div class="navbar-links">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-link-custom">Home</a>

                    <a href="/#services"
                       class="nav-link-custom">Services</a>

                    <a href="/#how-it-works"
                       class="nav-link-custom">How It Works</a>

                    <a href="/#about"
                       class="nav-link-custom">About</a>
                </div>

                <div class="navbar-actions">
                    <a href="#"
                       class="nav-login">Log in</a>

                    <a href="#"
                       class="nav-get-started">Get Started <span>→</span></a>
                </div>
            </div>

        </nav>
    </header>

    <!-- Page Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="transfero-footer">
        <div class="footer-main">
            <div class="footer-brand-section">
                <a class="transfero-brand footer-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon">T</span>
                    <span>transfero<span class="brand-dot">.</span></span>
                </a>

                <p>
                    Helping South African teachers explore transfer
                    opportunities and take their next career step.
                </p>
            </div>

            <div class="footer-links-section">
                <h3>Explore</h3>
                <a href="/#services">Our Services</a>
                <a href="/#how-it-works">How It Works</a>
                <a href="/#about">About Transfero</a>
            </div>

            <div class="footer-links-section">
                <h3>Account</h3>
                <a href="#">Log in</a>
                <a href="#">Get Started</a>
            </div>

            <div class="footer-links-section">
                <h3>Information</h3>
                <a asp-controller="Home"
                   asp-action="Privacy">Privacy</a>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© @DateTime.Now.Year Transfero. All rights reserved.</p>
            <p>Built to help teachers find their next opportunity.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

